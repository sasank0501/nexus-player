<Window x:Class="MpvFrontend.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="overlay" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        FontFamily="Segoe UI Variable Display, Segoe UI">
    <Grid MouseMove="Root_MouseMove">
        <!-- click layer: pause / double-click fullscreen.
             Alpha must be >0: layered windows are click-through on fully transparent pixels,
             and the overlay would stop receiving mouse input once the chrome fades out. -->
        <Rectangle x:Name="ClickLayer" Fill="#01000000" MouseLeftButtonDown="ClickLayer_MouseLeftButtonDown"/>

        <!-- everything that auto-hides -->
        <Grid x:Name="Chrome">

            <!-- top scrim + title block -->
            <Border VerticalAlignment="Top" Height="180" IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#A6000000" Offset="0"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <StackPanel x:Name="TitleBlock" Visibility="Collapsed"
                        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="44,36,0,0" IsHitTestVisible="False">
                <TextBlock Text="You're Watching" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                <TextBlock x:Name="TitleText" Text="" FontSize="27" FontWeight="Bold"
                           Foreground="White" Margin="0,4,0,0" MaxWidth="700" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="EpisodeText" Text="" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource Text}" Margin="0,6,0,0"/>
            </StackPanel>

            <!-- bottom scrim + controls -->
            <Grid VerticalAlignment="Bottom">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00000000" Offset="0"/>
                        <GradientStop Color="#E6000000" Offset="1"/>
                    </LinearGradientBrush>
                </Grid.Background>
                <StackPanel Margin="18,44,18,10">
                    <Grid Margin="4,0,4,4">
                        <TextBlock x:Name="TimeLabel" Text="00:00" FontSize="11.5" Foreground="{StaticResource Text}" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="DurationLabel" Text="00:00" FontSize="11.5" Foreground="{StaticResource Text}" HorizontalAlignment="Right"/>
                    </Grid>
                    <Slider x:Name="SeekSlider" Style="{StaticResource ModernSlider}"
                            Minimum="0" Maximum="100"
                            PreviewMouseLeftButtonDown="SeekSlider_MouseDown"
                            PreviewMouseMove="SeekSlider_MouseMove"
                            PreviewMouseLeftButtonUp="SeekSlider_MouseUp"/>
                    <Grid Margin="0,6,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Button Style="{StaticResource IconButton}" Content="&#xEB9E;" FontSize="18" Click="Rewind_Click" ToolTip="Back 10s"/>
                            <Button x:Name="PlayPauseButton" Style="{StaticResource PlayButton}" Content="&#xE768;" Click="PlayPause_Click"/>
                            <Button Style="{StaticResource IconButton}" Content="&#xEB9D;" FontSize="18" Click="Forward_Click" ToolTip="Forward 10s"/>
                            <Button x:Name="VolumeButton" Style="{StaticResource IconButton}" Content="&#xE767;" FontSize="17"
                                    Margin="10,0,2,0" Click="Mute_Click" ToolTip="Mute"/>
                            <Slider x:Name="VolumeSlider" Style="{StaticResource ModernSlider}" Width="96"
                                    Minimum="0" Maximum="150" Value="35" IsMoveToPointEnabled="True"
                                    ValueChanged="Volume_ValueChanged" VerticalAlignment="Center"/>
                            <StackPanel VerticalAlignment="Center" Margin="18,0,0,0" MaxWidth="340">
                                <TextBlock x:Name="NowPlayingTitle" Text="Nothing playing" FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="White" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="NowPlayingSub" Text="Add files from the Episodes panel" FontSize="10.5"
                                           Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Style="{StaticResource IconButton}" Content="&#xE7F0;" Click="SubToggle_Click" ToolTip="Subtitles"/>
                            <Button Style="{StaticResource IconButton}" Content="&#xE8D6;" Click="AudioCycle_Click" ToolTip="Audio track"/>
                            <Button Style="{StaticResource IconButton}" Content="&#xE713;" Click="Settings_Click" ToolTip="Settings"/>
                            <Button Style="{StaticResource IconButton}" Content="&#xE8A0;" Click="Sidebar_Click" ToolTip="Episodes panel"/>
                            <Button Style="{StaticResource IconButton}" Content="&#xE740;" Click="Fullscreen_Click" ToolTip="Fullscreen"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>

            <!-- settings panel -->
            <Border x:Name="SettingsPanel" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,24,128" Background="#F2161616" CornerRadius="12" Width="330" Padding="14,10">
                <StackPanel>
                    <Grid Height="38">
                        <TextBlock Text="Video Fit" FontSize="12.5" Foreground="{StaticResource Text}" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <RadioButton x:Name="FitContain" Style="{StaticResource PillRadio}" Content="Contain" FontSize="10.5" IsChecked="True" GroupName="fit" Checked="Fit_Checked"/>
                            <RadioButton x:Name="FitCover" Style="{StaticResource PillRadio}" Content="Cover" FontSize="10.5" GroupName="fit" Checked="Fit_Checked"/>
                            <RadioButton x:Name="FitFill" Style="{StaticResource PillRadio}" Content="Fill" FontSize="10.5" GroupName="fit" Checked="Fit_Checked"/>
                        </StackPanel>
                    </Grid>
                    <Grid Height="38">
                        <TextBlock Text="Speed" FontSize="12.5" Foreground="{StaticResource Text}" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <RadioButton x:Name="Speed1" Style="{StaticResource PillRadio}" Content="1x" FontSize="10.5" IsChecked="True" GroupName="speed" Checked="Speed_Checked"/>
                            <RadioButton x:Name="Speed125" Style="{StaticResource PillRadio}" Content="1.25x" FontSize="10.5" GroupName="speed" Checked="Speed_Checked"/>
                            <RadioButton x:Name="Speed15" Style="{StaticResource PillRadio}" Content="1.5x" FontSize="10.5" GroupName="speed" Checked="Speed_Checked"/>
                            <RadioButton x:Name="Speed2" Style="{StaticResource PillRadio}" Content="2x" FontSize="10.5" GroupName="speed" Checked="Speed_Checked"/>
                        </StackPanel>
                    </Grid>
                    <Grid Height="38">
                        <TextBlock Text="Display" FontSize="12.5" Foreground="{StaticResource Text}" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <RadioButton x:Name="DispSdr" Style="{StaticResource PillRadio}" Content="1440p SDR" FontSize="10.5" IsChecked="True" GroupName="disp" Checked="Display_Checked"/>
                            <RadioButton x:Name="DispHdr" Style="{StaticResource PillRadio}" Content="4K HDR" FontSize="10.5" GroupName="disp" Checked="Display_Checked"/>
                        </StackPanel>
                    </Grid>
                    <Border Height="1" Background="#22FFFFFF" Margin="0,4"/>
                    <Grid Height="42">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Anime4K Upscaler" FontSize="12.5" Foreground="{StaticResource Text}"/>
                            <TextBlock Text="GPU shader upscaling" FontSize="9.5" Foreground="{StaticResource TextMuted}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <RadioButton x:Name="A4kOff" Style="{StaticResource PillRadio}" Content="Off" FontSize="10.5" IsChecked="True" GroupName="a4k" Checked="Anime4k_Checked"/>
                            <RadioButton x:Name="A4kA" Style="{StaticResource PillRadio}" Content="A" FontSize="10.5" GroupName="a4k" Checked="Anime4k_Checked" ToolTip="Restore + upscale (most anime)"/>
                            <RadioButton x:Name="A4kB" Style="{StaticResource PillRadio}" Content="B" FontSize="10.5" GroupName="a4k" Checked="Anime4k_Checked" ToolTip="Soft restore (blurry sources)"/>
                            <RadioButton x:Name="A4kC" Style="{StaticResource PillRadio}" Content="C" FontSize="10.5" GroupName="a4k" Checked="Anime4k_Checked" ToolTip="Denoise + upscale (noisy sources)"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
