<Window x:Class="MpvFrontend.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nexus Player" Height="760" Width="1280"
        Background="{StaticResource Bg0}"
        FontFamily="{StaticResource UiFont}"
        WindowStyle="SingleBorderWindow"
        UseLayoutRounding="True">
    <!-- UseLayoutRounding snaps WPF's own layout to whole device pixels. Without
         it, VideoContainer's ActualWidth can land on a fractional pixel (e.g.
         1455.6), and while the title bar's WPF-rendered edge still lines up
         with the window's true right edge either way, ResizeMpvHost hands that
         fractional value to a *native* child window (mpv, via HwndHost), which
         rounds it on its own - independently of however WPF rounded the title
         bar above it. The two roundings don't always agree, and the result is
         a 1px seam between the title bar and the video exactly where the
         reader spotted it, by the caption buttons. -->
    <!-- "Sheet of glass": WindowStyle stays a real, WS_CAPTION-bearing window
         style (rather than None's bare popup) and GlassFrameThickness="-1"
         tells WindowChrome to extend that glass across the entire window, so
         none of the native frame ever actually paints - visually identical to
         a borderless window, but DWM still considers this a normal top-level
         window it owns the frame of, which is what DWMWA_WINDOW_CORNER_
         PREFERENCE (MainWindow.xaml.cs) needs to have any chance of working -
         it is a silent no-op on a WindowStyle="None" popup with no frame for
         it to round. Whether that chance pays off depends on the Windows
         shell: this app's actual corner rounding, the one guaranteed to show
         up regardless, comes from the SetWindowRgn clip in MainWindow.xaml.cs
         (see UpdateWindowRegion) - it doesn't depend on WindowStyle at all,
         but SingleBorderWindow's real frame is free and correct to keep
         regardless. CornerRadius stays 0 either way: neither mechanism is
         something WindowChrome itself needs to draw. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="-1" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TitleRow" Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- title bar -->
        <Grid x:Name="TitleBar" Grid.Row="0" Background="{StaticResource Bg0}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                <Path Style="{StaticResource IconPath}" Data="{StaticResource IconPlay}"
                      Stroke="{StaticResource Accent}" Width="13" Height="13" VerticalAlignment="Center"/>
                <TextBlock Text="N E X U S   P L A Y E R" Margin="10,0,0,0" FontSize="11.5"
                           FontWeight="SemiBold" Foreground="{StaticResource Text}" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource CaptionButton}" Tag="{StaticResource IconMinimize}" Click="MinButton_Click"/>
                <Button Style="{StaticResource CaptionButton}" Tag="{StaticResource IconMaximize}" Click="MaxButton_Click"/>
                <Button Style="{StaticResource CaptionButton}" Tag="{StaticResource IconClose}" Click="CloseButton_Click"/>
            </StackPanel>
        </Grid>

        <!-- body: full-bleed video + queue sidebar -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="SidebarCol" Width="300"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="VideoContainer" Grid.Column="0" Background="Black"/>

            <Border x:Name="Sidebar" Grid.Column="1" Background="{StaticResource Bg1}"
                    CornerRadius="10" Margin="0,0,8,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="14,14,10,6">
                        <TextBlock Text="Queue" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource Text}" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource IconButton}" Width="32" Height="32" FontSize="15"
                                    Tag="{StaticResource IconLink}" Click="OpenUrlButton_Click" ToolTip="Open URL"/>
                            <Button Style="{StaticResource IconButton}" Width="32" Height="32" FontSize="15"
                                    Tag="{StaticResource IconPlus}" Click="AddFilesButton_Click" ToolTip="Add files"/>
                            <Button Style="{StaticResource IconButton}" Width="32" Height="32" FontSize="15"
                                    Tag="{StaticResource IconTrash}" Click="RemoveButton_Click" ToolTip="Remove selected"/>
                        </StackPanel>
                    </Grid>

                    <Border x:Name="UrlPanel" Grid.Row="1" Visibility="Collapsed"
                            Background="{StaticResource Bg2}" CornerRadius="8" Margin="14,2,14,6" Padding="10,4">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                                    Width="28" Height="28" FontSize="14" Tag="{StaticResource IconPlay}"
                                    Click="PlayUrlButton_Click" ToolTip="Play URL"/>
                            <TextBox x:Name="UrlBox" Background="Transparent" BorderThickness="0"
                                     Foreground="{StaticResource Text}" CaretBrush="White" FontSize="12"
                                     VerticalContentAlignment="Center" KeyDown="UrlBox_KeyDown"/>
                        </DockPanel>
                    </Border>

                    <ListBox x:Name="PlaylistBox" Grid.Row="2" Margin="8,0,8,10"
                             Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource PlaylistItemStyle}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             MouseDoubleClick="PlaylistBox_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel ToolTip="{Binding Path}">
                                    <TextBlock Text="{Binding Name}" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Folder}" FontSize="10.5"
                                               Foreground="{StaticResource TextMuted}"
                                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
