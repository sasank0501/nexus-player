<Application x:Class="MpvFrontend.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Icons.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- ============================ palette ============================
                 Near-black rather than pure black for surfaces: panels sitting on
                 top of real video need to read as chrome, not as a hole. The video
                 area itself stays true black. -->
            <SolidColorBrush x:Key="Bg0" Color="#050505"/>
            <SolidColorBrush x:Key="Bg1" Color="#0E0E0E"/>
            <SolidColorBrush x:Key="Bg2" Color="#1A1A1A"/>
            <SolidColorBrush x:Key="Surface" Color="#F2181818"/>
            <SolidColorBrush x:Key="SurfaceRaised" Color="#FA202020"/>
            <SolidColorBrush x:Key="Hairline" Color="#22FFFFFF"/>
            <SolidColorBrush x:Key="Text" Color="#F2F2F2"/>
            <SolidColorBrush x:Key="TextMuted" Color="#8C8C8C"/>
            <SolidColorBrush x:Key="TextFaint" Color="#5E5E5E"/>
            <SolidColorBrush x:Key="Accent" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="Positive" Color="#4ADE80"/>
            <SolidColorBrush x:Key="TrackBg" Color="#33FFFFFF"/>
            <SolidColorBrush x:Key="TrackBuffered" Color="#59FFFFFF"/>
            <SolidColorBrush x:Key="HoverOverlay" Color="#14FFFFFF"/>
            <SolidColorBrush x:Key="PressOverlay" Color="#26FFFFFF"/>
            <SolidColorBrush x:Key="SelectedOverlay" Color="#1FFFFFFF"/>

            <FontFamily x:Key="UiFont">Segoe UI Variable Display, Segoe UI</FontFamily>

            <!-- scrims: keep chrome legible over any frame without tinting the
                 whole picture -->
            <LinearGradientBrush x:Key="TopScrim" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#A6000000" Offset="0"/>
                <GradientStop Color="#00000000" Offset="1"/>
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="BottomScrim" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#00000000" Offset="0"/>
                <GradientStop Color="#66000000" Offset="0.45"/>
                <GradientStop Color="#E6000000" Offset="1"/>
            </LinearGradientBrush>

            <!-- ========================== icon buttons ==========================
                 Content is unused; the icon geometry goes in Tag and its drawn size
                 in FontSize. That keeps every call site a single self-describing
                 line: Tag="{StaticResource IconPlay}" FontSize="20". -->
            <Style x:Key="IconButton" TargetType="Button">
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                <Setter Property="FontSize" Value="19"/>
                <Setter Property="Width" Value="38"/>
                <Setter Property="Height" Value="38"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="9">
                                <Path x:Name="ico"
                                      Style="{StaticResource IconPath}"
                                      Data="{TemplateBinding Tag}"
                                      Stroke="{TemplateBinding Foreground}"
                                      Width="{TemplateBinding FontSize}"
                                      Height="{TemplateBinding FontSize}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverOverlay}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource PressOverlay}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="ico" Property="Opacity" Value="0.35"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- primary transport button: bigger, no hover chrome -->
            <Style x:Key="TransportButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
                <Setter Property="Width" Value="46"/>
                <Setter Property="Height" Value="46"/>
                <Setter Property="FontSize" Value="26"/>
            </Style>

            <Style x:Key="CaptionButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
                <Setter Property="Width" Value="44"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            </Style>

            <!-- ============================ seek bar ============================
                 Full-bleed and thin at rest, thickening on hover with the handle
                 appearing — the reference bar runs edge to edge with no margin. -->
            <Style x:Key="SeekBar" TargetType="Slider">
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Height" Value="16"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Slider">
                            <Grid VerticalAlignment="Center" Background="Transparent">
                                <Border x:Name="trackBg" Height="3" CornerRadius="0"
                                        Background="{StaticResource TrackBg}" VerticalAlignment="Center"/>
                                <Border x:Name="trackBuffered" Height="3" CornerRadius="0"
                                        Background="{StaticResource TrackBuffered}" VerticalAlignment="Center"
                                        HorizontalAlignment="Left" Width="0"/>
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border x:Name="fill" Height="3" CornerRadius="0"
                                                            Background="{StaticResource Accent}"/>
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Background="Transparent" Height="16"/>
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb x:Name="thumb" Focusable="False">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Grid Background="Transparent" Width="14" Height="16">
                                                        <Ellipse x:Name="dot" Width="12" Height="12"
                                                                 Fill="{StaticResource Accent}" Opacity="0"/>
                                                    </Grid>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="trackBg" Property="Height" Value="6"/>
                                    <Setter TargetName="trackBuffered" Property="Height" Value="6"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- compact slider for volume and filter rows -->
            <Style x:Key="MiniSlider" TargetType="Slider">
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Height" Value="16"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Slider">
                            <Grid VerticalAlignment="Center" Background="Transparent">
                                <Border Height="3" CornerRadius="1.5" Background="{StaticResource TrackBg}"/>
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Height="3" CornerRadius="1.5" Background="{StaticResource Accent}"/>
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Background="Transparent" Height="16"/>
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Focusable="False">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Ellipse Width="11" Height="11" Fill="{StaticResource Accent}"/>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ========================= panels & menus ========================= -->

            <!-- letterspaced small caps section header: EPISODES, SCREENSHOTS -->
            <Style x:Key="SectionHeader" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource TextFaint}"/>
                <Setter Property="Margin" Value="10,10,10,6"/>
            </Style>

            <Style x:Key="PanelSurface" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource Surface}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Hairline}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.55" Color="Black"/>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ======================== settings menu row =======================
                 [icon] Label .......... CurrentValue >
                 Showing the current value inline is what makes the menu scan; v1's
                 settings panel had no value readout at all. -->
            <Style x:Key="MenuRow" TargetType="Button">
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Height" Value="38"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="Transparent" CornerRadius="8" Padding="10,0">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverOverlay}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="MenuRowIcon" TargetType="Path" BasedOn="{StaticResource IconPath}">
                <Setter Property="Width" Value="16"/>
                <Setter Property="Height" Value="16"/>
                <Setter Property="Stroke" Value="{StaticResource TextMuted}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <Style x:Key="MenuRowLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="12,0,0,0"/>
            </Style>

            <Style x:Key="MenuRowValue" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,0,6,0"/>
            </Style>

            <!-- right-aligned shortcut key, as the reference's More Options menu does -->
            <Style x:Key="ShortcutKey" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10.5"/>
                <Setter Property="FontFamily" Value="Consolas, Cascadia Mono"/>
                <Setter Property="Foreground" Value="{StaticResource TextFaint}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <!-- ============================== pills ============================== -->
            <Style x:Key="PillRadio" TargetType="RadioButton">
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="bd" CornerRadius="999" Padding="11,4" Background="Transparent">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverOverlay}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource Text}"/>
                                    <Setter Property="Foreground" Value="Black"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- preset tile: a title with a description line under it, as in the
                 reference's Anime4K mode grid -->
            <Style x:Key="PresetTile" TargetType="RadioButton">
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Margin" Value="3"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="bd" CornerRadius="8" Padding="8,7" Background="#14FFFFFF"
                                    BorderBrush="Transparent" BorderThickness="1">
                                <ContentPresenter HorizontalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource PressOverlay}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#33FFFFFF"/>
                                    <Setter TargetName="bd" Property="BorderBrush" Value="#66FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PresetTileTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
            </Style>

            <Style x:Key="PresetTileSub" TargetType="TextBlock">
                <Setter Property="FontSize" Value="9.5"/>
                <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,2,0,0"/>
            </Style>

            <!-- ============================ text button ============================ -->
            <Style x:Key="TextButton" TargetType="Button">
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontSize" Value="11.5"/>
                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" CornerRadius="8" Padding="10,8" Background="#14FFFFFF">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource PressOverlay}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ============================ scrollbar ============================ -->
            <Style TargetType="ScrollBar">
                <Setter Property="Width" Value="6"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#33FFFFFF" CornerRadius="3" Width="6"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ======================= queue / episode rows =======================
                 Left deliberately focusable: ListBoxItem selection needs Focus() to
                 succeed. Hotkeys still work because MainWindow binds PreviewKeyDown,
                 which runs before the item can eat the arrow keys. -->
            <Style x:Key="PlaylistItemStyle" TargetType="ListBoxItem">
                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="bd" CornerRadius="8" Padding="8,7" Margin="0,1" Background="Transparent">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverOverlay}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource SelectedOverlay}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
